GHL_TOKEN=
GHL_LOCATION_ID=dNVwWDNSHXa7vtxbnfub

# Apify — used only for the Zillow property-detail actor lookups in
# scripts/fetch_zillow.py.
APIFY_TOKEN=
# Actor id/name for the Zillow detail actor you want to run, e.g.
# "petr_cermak/zillow-detail-scraper" or an actor id like "abcXYZ123".
# Required — there is no safe default to guess here.
APIFY_ZILLOW_ACTOR_ID=
